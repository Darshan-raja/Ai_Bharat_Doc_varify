# 6. Verify changes
Select-String "dockerfile:" docker-compose.yml
Select-String "dockerfile:" .\.github\workflows\ci-cd.yml

# 7. Copy file
Copy-Item "d:\Downloads\files\ci-cd.yml" "c:\...\ci-cd.yml" -Force
```

