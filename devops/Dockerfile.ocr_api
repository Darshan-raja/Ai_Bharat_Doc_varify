# ─────────────────────────────────────────────────────────────────
# ML OCR API Service
# Lighter than forge_detection — only needs FastAPI + Gemini SDK
# ─────────────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY . .

# Add a non-root user for security
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
USER appuser

# Expose FastAPI port (different from forge_detection to avoid conflict)
EXPOSE 8001

# Health-check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/docs')" || exit 1

# Start the FastAPI server on port 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
