# ─────────────────────────────────────────────────────────────────
# Stage 1 – "builder"  (Node.js builds the React app)
# ─────────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests first (maximises Docker layer cache hits)
COPY package*.json ./

# Install all dependencies (Vite, React, Tailwind, etc.)
RUN npm ci

# Copy the full source code
COPY . .

# Accept the backend API URL as a build argument
# (Vite bakes this into the static bundle at build time)
ARG VITE_API_URL=http://localhost:5000
ENV VITE_API_URL=$VITE_API_URL

# Run the Vite production build — outputs to /app/dist
RUN npm run build

# ─────────────────────────────────────────────────────────────────
# Stage 2 – "production"  (Nginx serves the static files)
# Nginx is tiny (~20 MB) vs keeping the full Node image (~200 MB)
# ─────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Remove the default Nginx placeholder page
RUN rm -rf /usr/share/nginx/html/*

# Copy the built React app from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Custom Nginx config that supports React Router (client-side routing)
# Without this, refreshing any page other than "/" returns 404
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # All routes fall back to index.html (React Router handles them)\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Cache static assets for 1 year\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

# Expose port 80 (standard HTTP)
EXPOSE 80

# Health-check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

# Nginx starts in foreground (required for Docker)
CMD ["nginx", "-g", "daemon off;"]
